direction: down
vars: {d2-config: {pad: 0}}
term: "" {
  grid-columns: 1
  grid-gap: 14
  style: {fill: "#1f2430"; stroke: "#1f2430"; border-radius: 8}
  prompt: '$ myskill list on' {
    width: 172
    height: 26
    label.near: center-left
    style: {fill: transparent; stroke-width: 0; font: mono; font-size: 15; font-color: "#d8dee9"; bold: true}
  }
  summary: "" {
    grid-rows: 3
    grid-columns: 4
    grid-gap: 0
    style: {fill: transparent; stroke-width: 0}
