    }
    r1c2: '2 manual,' {
      width: 79
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#e0a75e"; bold: false}
    }
    r1c3: '2 off' {
      width: 47
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#ef7a7a"; bold: false}
    }
    r2c0: 'Opencode' {
      width: 79
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#d8dee9"; bold: false}
    }
    r2c1: '4 on,' {
      width: 47
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#9ccc65"; bold: false}
    }
    r2c2: '4 manual,' {
      width: 79
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#e0a75e"; bold: false}
    }
    r2c3: '0 off' {
      width: 47
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#ef7a7a"; bold: false}
    }
  }
  table: "" {
    grid-rows: 4
    grid-columns: 5
    grid-gap: 0
    style: {fill: transparent; stroke-width: 0}
    r0c0: 'skill' {
      width: 118
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#d8dee9"; bold: true}
    }
    r0c1: 'kind' {
      width: 102
      height: 22
      label.near: center-left
      style: {fill: transparent; stroke-width: 0; font: mono; font-size: 13; font-color: "#d8dee9"; bold: true}
    }
    r0c2: 'Claude' {
